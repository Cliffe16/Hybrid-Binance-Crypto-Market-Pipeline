    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "eg1isuu43iby8b"
                      },
                      "group": "marcusolsson-json-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "cacheDurationSeconds": 300,
                        "fields": [
                          {
                            "jsonPath": "$.data[0].average_price",
                            "name": "Latest",
                            "type": "number"
                          },
                          {
                            "jsonPath": "$.data[1].average_price",
                            "language": "jsonpath",
                            "name": "Previous"
                          }
                        ],
                        "method": "GET",
                        "queryParams": "",
                        "urlPath": "/candlesticks/${symbol}?limit=2"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": [
                {
                  "group": "calculateField",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "alias": "Difference",
                      "binary": {
                        "left": {
                          "matcher": {
                            "id": "byName",
                            "options": "Latest"
                          }
                        },
                        "operator": "-",
                        "right": {
                          "matcher": {
                            "id": "byName",
                            "options": "Previous"
                          }
                        }
                      },
                      "mode": "binary",
                      "reduce": {
                        "include": [
                          "Latest",
                          "Previous"
                        ],
                        "reducer": "diffperc"
                      }
                    }
                  }
                },
                {
                  "group": "calculateField",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "alias": "% Change",
                      "binary": {
                        "left": {
                          "matcher": {
                            "id": "byName",
                            "options": "Difference"
                          }
                        },
                        "operator": "/",
                        "right": {
                          "matcher": {
                            "id": "byName",
                            "options": "Previous"
                          }
                        }
                      },
                      "mode": "binary",
                      "reduce": {
                        "reducer": "sum"
                      }
                    }
                  }
                },
                {
                  "group": "organize",
                  "kind": "Transformation",
                  "spec": {
                    "options": {
                      "excludeByName": {
                        "Difference": true,
                        "Latest": false,
                        "Previous": false
                      },
                      "includeByName": {},
                      "indexByName": {},
                      "renameByName": {}
                    }
                  }
                }
              ]
            }
          },
          "description": "",
          "id": 1,
          "links": [],
          "title": "${symbol} Price & 24h Change",
          "vizConfig": {
            "group": "stat",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "color": {
