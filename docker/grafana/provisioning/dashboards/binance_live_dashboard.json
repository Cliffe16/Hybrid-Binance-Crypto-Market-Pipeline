                    "mode": "thresholds"
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "red",
                        "value": 0
                      },
                      {
                        "color": "green",
                        "value": 0
                      }
                    ]
                  },
                  "unit": "currencyUSD"
                },
                "overrides": [
                  {
                    "matcher": {
                      "id": "byName",
                      "options": "% Change",
                      "scope": "series"
                    },
                    "properties": [
                      {
                        "id": "unit",
                        "value": "percentunit"
                      }
                    ]
                  }
                ]
              },
              "options": {
                "colorMode": "background",
                "graphMode": "area",
                "justifyMode": "auto",
                "orientation": "auto",
                "percentChangeColorMode": "standard",
                "reduceOptions": {
